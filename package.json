  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/dm-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "typescript": "~6.0.2",
    "vite": "8.3.4"
  }
}
