{
  "name": "ignis-fire-laboratory",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:gpu": "playwright test --config playwright.gpu.config.ts --grep-invert \"benchmark|@chemistry-gate\"",
    "test:gpu:benchmark": "playwright test --config playwright.gpu.config.ts benchmark.spec.ts",
    "test:gpu:chemistry": "playwright test --config playwright.gpu.config.ts chemistry.spec.ts chemistry-state.spec.ts reactor.spec.ts --grep-invert @chemistry-gate && node scripts/chemistry_campaign.mjs --output artifacts/gpu-v14/campaign-v2",
    "test:gpu:sor": "playwright test --config playwright.gpu.config.ts sor-benchmark.spec.ts",
    "test:chemistry:storage": "node --test tests/chemistry-checkpoint.test.mjs",
    "test:chemistry:state": "playwright test --config playwright.gpu.config.ts chemistry-state.spec.ts",
    "chemistry:campaign": "node scripts/chemistry_campaign.mjs",
    "test:gpu:chemistry:reference": "playwright test --config playwright.gpu.config.ts reactor.spec.ts --grep @chemistry-gate"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/dm-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "typescript": "~6.0.2",
    "vite": "8.3.4"
  }
}
