&HEAD CHID='ignis', TITLE='IGNIS quantitative educational experiment' /
&MESH IJK=32,32,64, XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000 /
&TIME T_END=6.0, WALL_INCREMENT=20 /
&MISC TMPA=20, Y_O2_INFTY=0.231832140 /
&DUMP DT_DEVC=0.1, DT_HRR=0.1, DT_SLCF=0.15 /
&RADI RADIATION=.TRUE., NUMBER_RADIATION_ANGLES=50 /
&SPEC ID='OXYGEN' /
&SPEC ID='NITROGEN' /
&SPEC ID='SOOT' /
&REAC FUEL='METHANE', SOOT_YIELD=0.008, CO_YIELD=0.005 /
&SURF ID='SOURCE', SPEC_ID(1:3)='METHANE','OXYGEN','NITROGEN', MASS_FLUX(1:3)=0.03,0.036,0.11928476749892562, TAU_MF=0.2, COLOR='GRAY 30' /
&OBST XB=-0.01,0.01,-0.01,0.01,0.,0.04, SURF_IDS='SOURCE','INERT','INERT' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='HRRPUV', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='DENSITY', SPEC_ID='SOOT', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='U-VELOCITY', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='V-VELOCITY', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.08000000,0.08000000,-0.08000000,0.08000000,0.00000000,0.32000000, QUANTITY='W-VELOCITY', CELL_CENTERED=.TRUE. /
&DEVC ID='probe_T', XYZ=0.,0.,0.14400000000000002, QUANTITY='TEMPERATURE' /
&DEVC ID='probe_O2', XYZ=0.,0.,0.14400000000000002, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&TAIL /
