&HEAD CHID='ignis', TITLE='IGNIS quantitative educational experiment' /
&MESH IJK=32,32,56, XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000 /
&TIME T_END=2.0, WALL_INCREMENT=20 /
&MISC TMPA=20, Y_O2_INFTY=0.231832140 /
&DUMP DT_DEVC=0.1, DT_HRR=0.1, DT_SLCF=0.1, DT_SL3D=0.1 /
&RADI RADIATION=.TRUE., NUMBER_RADIATION_ANGLES=50 /
&SPEC ID='OXYGEN' /
&SPEC ID='NITROGEN' /
&SPEC ID='SOOT' /
&REAC FUEL='WOOD', C=3.4, H=6.2, O=2.5, HEAT_OF_COMBUSTION=12000., SOOT_YIELD=0.015 /
&SPEC ID='WATER VAPOR' /
&MATL ID='CHAR', DENSITY=180., CONDUCTIVITY=1.0, SPECIFIC_HEAT=1.6, EMISSIVITY=1.0 /
&MATL ID='PINE', DENSITY=360., CONDUCTIVITY=0.05, SPECIFIC_HEAT=1.0, EMISSIVITY=1.0, A=1.E20, E=1.6E5, NU_MATL=0.5, MATL_ID='CHAR', NU_SPEC=0.5, SPEC_ID='WOOD', HEAT_OF_REACTION=1000. /
&MATL ID='MOISTURE', DENSITY=1000., CONDUCTIVITY=0.6, SPECIFIC_HEAT=4.18, A=1.E10, E=8.E4, NU_SPEC=1., SPEC_ID='WATER VAPOR', HEAT_OF_REACTION=2257. /
&SURF ID='SAMPLE', MATL_ID(1,1:2)='PINE','MOISTURE', MATL_MASS_FRACTION(1,1:2)=0.88,0.12, THICKNESS=0.015, EXTERNAL_FLUX=55.0, RAMP_EF='IGNITION', BACKING='INSULATED', COLOR='BROWN' /
&RAMP ID='IGNITION', T=0., F=1. /
&RAMP ID='IGNITION', T=1.3, F=1. /
&RAMP ID='IGNITION', T=1.4000000000000001, F=0. /
&OBST XB=-0.045,0.045,-0.045,0.045,0.,0.03, SURF_IDS='SAMPLE','INERT','INERT' /
&DEVC ID='surface', XYZ=0.,0.,0.03, IOR=3, QUANTITY='WALL TEMPERATURE' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='HRRPUV', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='DENSITY', SPEC_ID='SOOT', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='U-VELOCITY', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='V-VELOCITY', CELL_CENTERED=.TRUE. /
&SLCF XB=-0.12000000,0.12000000,-0.12000000,0.12000000,0.00000000,0.40000000, QUANTITY='W-VELOCITY', CELL_CENTERED=.TRUE. /
&DEVC ID='probe_T', XYZ=0.,0.,0.18000000000000002, QUANTITY='TEMPERATURE' /
&DEVC ID='probe_O2', XYZ=0.,0.,0.18000000000000002, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&TAIL /
